{
  "name": "@data-fair/app-charts",
  "version": "1.3.7",
  "description": "A simple charts application for data-fair",
  "type": "module",
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "homepage": "https://data-fair.github.io/3/user-guide-backoffice/charts",
  "scripts": {
    "analyze": "cross-env ANALYZE=true npm run build-dev",
    "dev": "zellij --layout .zellij.kdl",
    "dev-server": "cross-env APP_URL=http://localhost:3000/app/ df-dev-server",
    "dev-app": "vite --port 3000",
    "build": "cross-env-shell PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-charts@${npm_package_version}/dist \"npm run prepareBuild && vite build\"",
    "build-preview": "npm run prepareBuild && vite build",
    "build-staging": "npm run prepareBuild && cross-env-shell PUBLIC_URL=https://staging-koumoul.com/apps/charts/master/ \"vite build\"",
    "build-types": "df-build-types && ncp src/config/.type/resolved-schema.json public/config-schema.json",
    "lint": "eslint . --fix",
    "precommit": "npm run lint",
    "type-check": "vue-tsc --noEmit",
    "prepareBuild": "rimraf dist && npm run build-types",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "files": [
    "/dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@data-fair/lib-utils": "^1.10.2",
    "@data-fair/lib-vue": "^1.27.2",
    "@data-fair/lib-vuetify": "^2.3.0",
    "@energiency/chartjs-plugin-piechart-outlabels": "^1.3.5",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.20",
    "natural-orderby": "^5.0.0",
    "ofetch": "^1.5.1",
    "vue": "^3.5.33",
    "vue-chartjs": "^5.3.3",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
    "@data-fair/dev-server": "^2.0.24",
    "@data-fair/lib-types-builder": "^1.12.0",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "ncp": "^2.0.0",
    "neostandard": "^0.13.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.70.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.7"
  }
}
