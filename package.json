{
  "name": "@data-fair/app-charts",
  "version": "1.3.9",
  "description": "A simple charts application for data-fair",
  "type": "module",
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "homepage": "https://data-fair.github.io/3/user-guide-backoffice/charts",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "npm run prepareBuild && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-charts@${npm_package_version}/dist vite build",
    "build-preview": "npm run prepareBuild && vite build",
    "build-staging": "npm run prepareBuild && PUBLIC_URL=https://staging-koumoul.com/apps/charts/master/ vite build",
    "build-types": "df-build-types src/config",
    "prepareBuild": "npm run build-types",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "/dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@data-fair/lib-utils": "^1.13.1",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.3",
    "@energiency/chartjs-plugin-piechart-outlabels": "^1.3.5",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.20",
    "ofetch": "^1.5.1",
    "vue": "^3.5.33",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.4.10",
    "vuetify": "^4.0.6"
  },
  "peerDependencies": {
    "@data-fair/lib-utils": "^1.13.1",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.3",
    "@vueuse/core": ">=10",
    "dayjs": "1",
    "ofetch": "1",
    "vue": "3",
    "vue-i18n": "10 || 11",
    "vuetify": "4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@data-fair/dev-server": "^2.6.2",
    "@data-fair/lib-common-types": "^1.23.0",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.60.0",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.104.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.7"
  }
}
